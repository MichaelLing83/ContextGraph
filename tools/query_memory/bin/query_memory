#!/bin/bash
# Wrapper script: always use base conda Python (3.11+) to avoid SyntaxError
# on old testbed Pythons (<3.7) that can't handle neo4j's annotations.
# The SWE-bench testbed env may use Python 3.6, but the base conda Python is 3.11+.
# IMPORTANT: Do NOT use 'exec' — SWE-agent runs this in a pexpect bash session,
# and exec would replace the shell process, causing EOF when Python exits.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TOOL_ROOT="$(dirname "$SCRIPT_DIR")"

export PYTHONPATH="$TOOL_ROOT/lib:${PYTHONPATH:-}"

# Try known Python 3.11+ locations (base conda, standalone, system)
for PYBIN in /opt/miniconda3/bin/python3 /root/python3.11/bin/python3.11; do
    if [ -x "$PYBIN" ]; then
        "$PYBIN" "$SCRIPT_DIR/query_memory_impl.py" "$@"
        exit $?
    fi
done

# Last resort: system python3 (may fail on old testbed envs)
python3 "$SCRIPT_DIR/query_memory_impl.py" "$@"
